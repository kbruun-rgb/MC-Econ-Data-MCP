# Same DATABASE_URL as the main site's .env (shared Postgres -- API key
# validation and query audit logging against the same tables).
DATABASE_URL=postgresql://...

# Same R2 credentials/bucket as the main site's .env (reads the "data/"
# prefix that export_mcp_datasets.py writes to; sync_to_cloud.py never
# touches this prefix).
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# This service's own public URL, once deployed (used for OAuth resource
# metadata, not an actual OAuth flow -- clients just send a bearer token).
MCP_PUBLIC_URL=https://mc-econ-data-mcp.onrender.com

# The main site's own URL (used as the auth "issuer" -- tokens are minted
# by /connect there, not by a real separate auth server).
SITE_BASE_URL=https://mc-econ-intel.onrender.com
